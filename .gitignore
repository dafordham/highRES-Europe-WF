# [cl] --- HighRES: large input data ---
# [cl] shared_input/ is a symlink to the copy in Article_Marianne. intermediate_data
# is a 1.1 GB copy of the outputs of build_shapes and build_vre_cf_grid, the two
# rules that need ~50 GB RAM. Neither belongs in git, and neither survives a
# fresh clone. See CLAUDE.md for how to reconstitute them.
shared_input/
geodata/
weatherdata/
intermediate_data/
resources.zip
weatherdata.zip
geodata.zip

# [cl] --- HighRES: generated work/results ---
work/
**/work/
*.gdx
*.lst
*.log
*.dd
*.parquet
*.db
*.db.compressed
*.csv
*.ods
*.xls
*.xlsx
*.txt

# [cl] Run output dirs, named work_<machine>_<horizon>_<mode>. Glob so renaming the
# scheme cannot silently un-ignore gigabytes.
work_*/
**/work_*/

# [cl] --- OS / editor junk ---
Thumbs.db
.idea/
.vscode/
*.swp

