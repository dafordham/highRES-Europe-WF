windoff_bottom_af = config["parameters"]["windoff_bottom_af"]
windoff_floating_af = config["parameters"]["windoff_floating_af"]

# Generate all combinations of spatials, psys/esys scenarios 
# combinations = list(itertools.product(spatials, psys_scenarios, esys_scenarios))
# scenarios = pd.DataFrame(combinations, columns=["year", "spatial", "psys_scenario", "esys_scenario"])

# Generate all combinations of spatials, psys/esys, pathway scenarios 
combinations = list(itertools.product(spatials, psys_scenarios, esys_scenarios, 
        solar_scenarios, wind_scenarios, transmission_scenarios, emission_scenarios, growth_scenarios))

planning_horizons = [str(h) for h in config["parameters"]["planning_horizons"]]
years = [str(y) for y in config["parameters"]["years"]]

if len(years) == 1:
    years = years * len(planning_horizons)


pathway_combinations = [
    c + (h, years[i])
    for c in combinations
    for i, h in enumerate(planning_horizons)
]

# pathway_scenarios = pd.DataFrame(pathway_combinations, columns=["spatial", "psys_scenario", "esys_scenario", "planning_horizon", "year"])
pathway_scenarios = pd.DataFrame(pathway_combinations, 
    columns=["spatial", "psys_scenario", "esys_scenario", 
        "solar_scenario", "wind_scenario", "transmission_scenario", 
        "emission_scenario", "growth_scenario", "planning_horizon",
        "year",
    ]
)

years = pathway_scenarios.year.to_list()
spatials = pathway_scenarios.spatial.to_list()
psys_scenarios = pathway_scenarios.psys_scenario.to_list()
esys_scenarios = pathway_scenarios.esys_scenario.to_list()
pathway_horizons = pathway_scenarios.planning_horizon.to_list()
solar_scenarios = pathway_scenarios.solar_scenario.to_list()
wind_scenarios = pathway_scenarios.wind_scenario.to_list()
transmission_scenarios = pathway_scenarios.transmission_scenario.to_list()
emission_scenarios = pathway_scenarios.emission_scenario.to_list()
growth_scenarios = pathway_scenarios.growth_scenario.to_list()

ev_scenario = config["parameters"]["EV_scenario"]

bias_correction = config["parameters"]["bias_correction"]
elevation_excl = config["parameters"]["elevation_excl"]
onshore_slope_excl = config["parameters"]["onshore_slope_excl"]

# Get current working directory

cwd = pathlib.Path().resolve()

# Absolute path to your GAMS installation
gamspath = config["paths"]["gams"]
gamspath = str(gamspath)

# Absolute path to the input data that is the same across all versions
