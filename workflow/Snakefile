rule build_ev_inputs:
    input:
        "resources/ev_data/EV_grid_connected_power_kW.csv",
        "resources/ev_data/EV_driving_demand_kWh.csv",
        "resources/ev_data/EV_charging_demand_to_EV_kWh.csv",
        ev_scenarios="resources/ev_data/ev_scenarios.csv",
        # pathways: ancient, so editing or pulling the scripts does not rebuild every milestone
        data2dd=ancient(pathlib.Path(workflow.basedir) / "scripts"),
    output:
        horizonpath / "ev_data.dd",
    params:
        date_range=date_range,
        aggregated_regions=aggregated_regions,
        ev_scenario=ev_scenario,
        EV_soc_min=config["parameters"]["EV_soc_min"],
        planning_horizon=lambda wildcards: wildcards.horizon,
    notebook:
        "notebooks/highRES_build_ev_inputs.ipynb"


# This rule exists so users can stop the workflow after the input creation, to
# not have it automatically run the model as well, in case this is not desired.
rule build_inputs:
    input:
        # unpack(inputfilelist)
        regionsdd=sharedpath / "_regions.dd",
        zonesdd=sharedpath / "zones.dd",
        temporaldd=horizonpath / "{year}_temporal.dd",
        vreareasdd=sharedpath / "vre_areas_{year}_.dd",
        demandfile=rules.build_technoeconomic_inputs.output.demandfile,
        vregdxcompressed=sharedpath / "vre_gdx.compressed",
        vregdx=sharedpath / "vre_{year}_.gdx",
        hydroresinflowgdx=sharedpath / "hydro_res_inflow_{year}.gdx",
        hydroresinflowcompressed=rules.compress_hydrores_inflow.output.compressdone,
        gendd=horizonpath / "{psys_scenario}_gen.dd",
        storedd=horizonpath / "{psys_scenario}_store.dd",
        transdd=horizonpath / "trans.dd",
        cplexopt=sharedpath / "cplex.opt",
        evdatadd=horizonpath / "ev_data.dd",
    output:
        touch(horizonpath / "inputs.finished"),
    run:
        import shutil

        dest = pathlib.Path(output[0]).parent

        for src in [
            input.regionsdd, input.zonesdd,
            input.vreareasdd, input.vregdx, input.hydroresinflowgdx,
            input.cplexopt,
        ]:
            shutil.copy(src, str(dest))


# Files that are marked temporary upon creation, but can only be deleted after
# the model has run, need to be listed as an input both here and in the rule
# "build_inputs". If they are only listed in "build_inputs", but not here, they
# would be deleted before the model runs and so the run breaks.
gams_inputs = [
    shared_code_path + "highres.gms",
    shared_code_path + "highres_data_input.gms",
    shared_code_path + "highres_hydro.gms",
    shared_code_path + "highres_results.gms",
    shared_code_path + "highres_storage_setup.gms",
    shared_code_path + "highres_storage_uc_setup.gms",
    shared_code_path + "highres_uc_setup.gms",
    horizonpath / "inputs.finished",
    sharedpath / "vre_{year}_.gdx",
]

# pathways
# The scenario settings of a solve, shared by run_gams and run_robust_loop so
# that both solve a milestone the same way. workflow/scripts/gams_args.py turns
# them into GAMS arguments.
gams_params = dict(
    gamspath=gamspath,
    #co2intensity=config["parameters"]["co2target"],
    co2_target_type=config["parameters"]["co2_target_type"],
    co2_target_extent=config["parameters"]["co2_target_extent"],
    energy_system_scenario=lambda wildcards: wildcards.esys_scenario,
    sharedcodepath=abs_gams_code_path,
    outname="results",
    store_initial_level=config["parameters"]["store_initial_level"],
    store_final_level=config["parameters"]["store_final_level"],
    hydro_res_initial_fill=config["parameters"]["hydro_res_initial_fill"],
    hydro_res_min=config["parameters"]["hydro_res_min"],
    pgen=config["parameters"]["pgen"],
    emis_price=config["parameters"]["emis_price"],
    # trans_inv=config["parameters"]["trans_inv"],
    trans_inv=lambda wildcards: wildcards.transmission_scenario,
    trans_cap_lim=config["parameters"]["trans_cap_lim"],
    unit_commitment=config["parameters"]["unit_commitment"],
    frequency_response=config["parameters"]["frequency_response"],
    store_uc=config["parameters"]["store_uc"],
    EV=config["parameters"]["EV"],
    EV_flex = config["parameters"]["EV_flex"],
    V2G=config["parameters"]["V2G"],
    EV_soc_max=config["parameters"]["EV_soc_max"],
)

rule run_gams:
    input:
        gams_inputs,
    params:
        **gams_params,
        horizonpath=lambda wildcards, output: str(pathlib.Path(output.modelresults).parent),
        # pathways
        # Climate-Robust Pathways: default to a stock expansion run so existing
        # configs that predate these switches keep working unchanged.
        fix_fleet=config["parameters"].get("fix_fleet", ""),
        ens_obj=config["parameters"].get("ens_obj", "OFF"),
    # pathways
    # The SLURM executor derives cpus_per_task from threads when
    # cpus_per_task is not given as a resource, so this is what sizes the
    # solve's allocation. It MUST match cplex_options.threads in the config,
    # or CPLEX spawns a different number of threads than SLURM allocated.
    #
    # Declared per rule rather than through --default-resources cpus_per_task,
    # which applied 30 cores to every submitted rule and left light ones 
    # queueing for a 30-core slot they never use.
    threads: 30
    resources:
        mem_mb=50000,
    log:
        str(horizonpath) + "/highres.lst",
        str(horizonpath) + "/highres.log",
    output:
        modelresults=protected(horizonpath / "results.gdx"),
        # modelresultsdd=protected(modelpath / "results.db"),
    script:
        "scripts/run_gams.py"


# pathways
# Climate-Robust Pathways. With robust.enabled in the config, a milestone is
# solved by the robust loop instead of one expansion: dispatch the fleet
# against every realisation, expand on the worst, repeat until all clear
# (workflow/scripts/pathway_step.py). Both rules write the same results.gdx,
# so the ruleorder picks one and every rule after it is unchanged. The other
# settings are documented in config/config_robust_local_5day.yaml.
robust = config.get("robust", {})

if robust.get("enabled", False):
    ruleorder: run_robust_loop > run_gams
else:
    ruleorder: run_gams > run_robust_loop


rule run_robust_loop:
    input:
        gams_inputs,
        realisations=robust.get("realisations", "config/realisations.yaml"),
        vre_parquet=sharedpath / "vre_{year}_.parquet",
    params:
        **gams_params,
        horizonpath=lambda wildcards, output: str(pathlib.Path(output.modelresults).parent),
        robust=robust,
        zones=aggregated_regions,
        scriptsdir=pathlib.Path(workflow.basedir) / "scripts",
    # One job for the whole milestone. A rank runs one dispatch per
    # realisation at the same time, so cores = realisations x CPLEX threads.
    threads: robust.get("cores", 1)
    resources:
        mem_mb=robust.get("mem_mb", 8000),
        runtime=robust.get("runtime", "24h"),
    log:
        str(horizonpath) + "/robust.log",
    output:
        modelresults=protected(horizonpath / "results.gdx"),
    script:
        "scripts/run_robust_loop.py"


rule convert_results:
    input:
        rules.run_gams.output.modelresults,
    output:
        resultsdb=ensure(protected(horizonpath / "results.db"), non_empty=True),
    shell:
        # TODO platform independence
        gamspath + "gamstool sqlitewrite gdxIn={input} o={output}"


rule build_capacity_ledger:
    input:
        technoeconomic_database="resources/highres_technoeconomic_database.ods",
        scenario_db="resources/highres_scenarios.xls",
        zones="resources/zones.csv",
        results_gdx=rules.run_gams.output.modelresults,
        prior_ledger=resolve_prior_ledger,
        # pathways: ancient, so editing or pulling the scripts does not rebuild every milestone
        data2dd=ancient(pathlib.Path(workflow.basedir) / "scripts"),
        gen_database="resources/gen_database.csv",
    output:
        ledger=horizonpath / "capacity_ledger.csv",
    conda:
        "envs/build_capacity_ledger.yml",
    params:
        planning_horizon=lambda wildcards: wildcards.horizon,
        baseline_year=config["parameters"]["baseline_year"],
        gamspath=gamspath
    notebook:
        "notebooks/highRES_build_capacity_ledger.ipynb"


rule convert_results_db_parquet:
    input:
        rules.convert_results.output.resultsdb,
        rules.build_capacity_ledger.output.ledger,  # ensures every horizon's ledger gets built
    output:
        compressdone=touch(horizonpath / "results.db.compressed"),
    resources:
        mem_mb=50000,
    conda:
        "envs/build_vre_parquet.yml"
    script:
        "scripts/convert_results_sqlite_parquet.py"

