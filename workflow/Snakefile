def resolve_prior_ledger(wildcards):
    idx = planning_horizons.index(wildcards.horizon)
    if idx == 0:
        return []
    prior_horizon = planning_horizons[idx - 1]
    prior_year = years[idx - 1]
    # scenario_path = resultspath / f"{wildcards.psys_scenario}_{wildcards.esys_scenario}_{wildcards.spatial}_{wildcards.solar_scenario}_{wildcards.wind_scenario}_{wildcards.transmission_scenario}_{wildcards.emission_scenario}_{wildcards.growth_scenario}"
    scenario_path = resultspath / f"{wildcards.psys_scenario}_{wildcards.esys_scenario}_{wildcards.spatial}/{wildcards.solar_scenario}_{wildcards.wind_scenario}_{wildcards.transmission_scenario}_{wildcards.emission_scenario}_{wildcards.growth_scenario}"
    return scenario_path / f"{prior_horizon}_{prior_year}" / "capacity_ledger.csv"
    # return modelpath / f"{prior_horizon}_{prior_year}" / "capacity_ledger.csv" # Is it better in this way?

rule build_technoeconomic_inputs:
    input:
        "resources/zones.csv",
        "resources/highres_scenarios.xls",
        "resources/highres_technoeconomic_database.ods",
        europedemandcsvlocation="resources/europe_demand_{esys_scenario}_{horizon}.csv",
        co2_targets_db="resources/europe_co2_targets.csv",
        vre_connection_dists=rules.build_vre_cf_inputs.output.vre_connection_dists,
        data2dd="workflow/scripts/data2dd_funcs.py",
        gen_database="resources/gen_database.csv",
        prior_ledger=resolve_prior_ledger,
    conda:
        "envs/build_technoeconomic.yml"
    output:
        horizonpath / "{year}_temporal.dd",
        horizonpath / "{psys_scenario}_gen.dd",
        horizonpath / "{psys_scenario}_store.dd",
        horizonpath / "trans.dd",
        co2_target=horizonpath / "{esys_scenario}_co2_target.dd",
        demandfile=horizonpath / "{esys_scenario}_demand_{year}.dd",
    params:
        aggregated_regions=aggregated_regions,
        date_range=date_range,
        user_mode=user_mode,
        co2_target_type=config["parameters"]["co2_target_type"],
        co2_target_extent=config["parameters"]["co2_target_extent"],
        energy_system_scenario=lambda wildcards: wildcards.esys_scenario,
        planning_horizon=lambda wildcards: wildcards.horizon,
        baseline_year=config["parameters"]["baseline_year"],
        growth_seed=config["parameters"]["gen_growth_seed_mw"],
    script:
        "scripts/data2dd.py"


