# Write scenarios to file, so results analysis script can check if they are all
# available.
#scenarios.to_csv(resultspath / "scenarios.csv", sep="\t")

run_name=["psys_scenario","esys_scenario","spatial"]

pathway_scenarios["run_name"]=pathway_scenarios[run_name].stack().groupby(level=0).agg("_".join)
pathway_scenarios.loc[:, ["solar_scenario", "wind_scenario", "transmission_scenario", "emission_scenario", "growth_scenario", "planning_horizon", "year", "run_name"]].to_csv(resultspath / "scens.csv", index=False, header=False)

# Relative path to workdir

