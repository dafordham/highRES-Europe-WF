horizonpath=modelpath / "{horizon}_{year}"
wildcard_constraints:
    horizon="|".join(planning_horizons),
    year="|".join(sorted(set(years))),
    psys_scenario="[^/]+",
    esys_scenario="[^/]+",
    spatial="[^/]+",

localrules:
    all,
    build_cplex_opt,
    build_technoeconomic_inputs,
    build_zones_file,
    build_shapes,
    # pathways
    # build_vre_cf_grid and build_vre_land_avail need ~50 GB each, so they are
