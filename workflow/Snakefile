    build_capacity_ledger,
    build_ev_inputs,
    build_inputs,
    # run_gams is deliberately NOT listed here. As a local rule it executes in
    # the Snakemake process itself, which on fox means the solve runs on the
    # login node. Leave it out so --executor slurm submits it as a job.
    #
    # DO NOT put --job-name in slurm_extra for it either. The SLURM executor
    # sets the job name itself and rejects a second one inside its submission
    # thread, so Snakemake prints "Execute N jobs" and then hangs in
    # futex_do_wait.


rule all:
    input:
        expand(horizonpath / config["target"], zip, psys_scenario=psys_scenarios, esys_scenario=esys_scenarios,
        year=years, spatial=spatials, horizon=pathway_horizons,
        solar_scenario=solar_scenarios, wind_scenario=wind_scenarios, transmission_scenario=transmission_scenarios,
        emission_scenario=emission_scenarios, growth_scenario=growth_scenarios)    

rule build_cplex_opt:
    output:
        sharedpath / "cplex.opt",
    params: config["cplex_options"],
    run:
        cplex_options = config["cplex_options"]

        # Open the file in write mode
        with open(output[0], "w") as f:
            for option, value in cplex_options.items():
                f.write(f"{option} {value}\n")


