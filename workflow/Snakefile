# Pathway scenarios
solar_scenarios = config["parameters"]["solar_scenarios"]
wind_scenarios = config["parameters"]["wind_scenarios"] # including social and environmental exclusions
transmission_scenarios = config["parameters"]["trans_inv"]
emission_scenarios = config["parameters"]["emission_scenarios"]
growth_scenarios = config["parameters"]["growth_rate_scenarios"]

spatials = config["parameters"]["spatials"]
psys_scenarios = config["parameters"]["power_system_scenario"]
esys_scenarios = config["parameters"]["energy_system_scenario"]

cutoff_values = {
    "solar": config["parameters"]["cutoff_solar"],
    "onwind": config["parameters"]["cutoff_onwind"],
    "offwind": config["parameters"]["cutoff_offwind"],
}

corine_codes = {
    "solar": config["parameters"]["solar_clc"],
    "onwind_no_buffer": config["parameters"]["onwind_clc_no_buffer"],
    "onwind_buffer": config["parameters"]["onwind_clc_buffer"],
}

windoff_floating = config["parameters"]["windoff_floating"]
windturbines = config["parameters"]["windturbines"]
